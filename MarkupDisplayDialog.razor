@namespace Mas.Infrastructure.BlazorComponents

@using MudBlazor

<MudDialog>
    <DialogContent>
        <Display EnableZoom="@EnableZoom"
                 DisableZoom="@DisableZoom">
            @Content
        </Display>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public MarkupString Content { get; set; }

    [Parameter] public Action EnableZoom { get; set; } = () => { };
    [Parameter] public Action DisableZoom { get; set; } = () => { };

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

}
